// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum AiCategory {
  FOOD
  TRAVEL
  SHOPPING
  BILLS
  HEALTHCARE
  ENTERTAINMENT
  EDUCATION
  INCOME
  OTHER
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  // nullable to support Google OAuth users
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts Account[]
  budgets  Budget[]
  reports  Report[]

  @@map("users")
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  bankName    String
  accountName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id          String          @id @default(cuid())
  accountId   String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  merchant    String
  description String?
  category    String?         // user-set or manually overridden category
  type        TransactionType
  aiCategory  AiCategory?     // AI-assigned category
  confidence  Float?          // AI confidence score 0.0 – 1.0
  riskScore   Int?            @default(0) // fraud risk score 0–100
  isFlagged   Boolean         @default(false)
  hash        String?         // dedup hash: accountId+date+amount+merchant
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@index([type])
  @@index([isFlagged])
  @@index([hash])
  @@map("transactions")
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  category     String   // matches AiCategory values
  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category]) // one budget per category per user
  @@map("budgets")
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  month     String   // format: "YYYY-MM"
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month]) // one report per month per user
  @@map("reports")
}
