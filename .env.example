# ─── Backend ───────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/finance_copilot"

# JWT secret (use a long random string in production)
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# ─── AI Provider ───────────────────────────────────────────
# Set AI_PROVIDER to "gemini" and add your key to use real AI.
# Leave as "mock" for development — no API key required.
#
#   "mock"   → deterministic keyword-based responses (default)
#   "gemini" → real Gemini 2.5 Flash API (requires GEMINI_API_KEY)
#
# Get your key at: https://aistudio.google.com/app/apikey
# Note: New API keys start with "AQ." and work with gemini-2.5-flash
# Old "AIza..." keys are for deprecated gemini-pro model
AI_PROVIDER="mock"
GEMINI_API_KEY="your_gemini_api_key_here"

# PDF reports — path to Chrome/Edge executable
# Leave blank to auto-detect. Override if Chrome is in a non-standard location.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
